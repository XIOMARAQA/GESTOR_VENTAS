DJANGO_SECRET_KEY=cambiar-en-produccion
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL (DBeaver / local). Puede compartir BD con otras apps (p. ej. helpmed en otro esquema).
# Tablas de Gestor de Ventas viven en el esquema DB_SCHEMA (por defecto gestorVentas).
# Tras crear el esquema vacío: python manage.py migrar_esquema_gestor_ventas --yes
# DB_SCHEMA=gestorVentas
# Base típica: postgres, o crea una dedicada (ej. gestor_ventas) y apunta aquí.
# Formato: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
# Ejemplo DBeaver localhost:5432, usuario postgres:
# DATABASE_URL=postgres://postgres:TU_CLAVE@localhost:5432/postgres
#
# Si cambiaste de UUID a IDs enteros (BigAutoField): la BD antigua no es compatible.
# Opción A: nueva base de datos y luego migrate. Opción B en DBeaver (¡borra todo!):
#   DROP SCHEMA public CASCADE; CREATE SCHEMA public;
#   GRANT ALL ON SCHEMA public TO postgres; GRANT ALL ON SCHEMA public TO public;
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# En producción: API_REQUIRE_AUTH=true
API_REQUIRE_AUTH=false

# --- Superusuario de plataforma (login Vue: RUC vacío + correo + contraseña) ---
# Ejecutar una vez: python manage.py ensure_platform_owner
# No subir contraseñas reales al repositorio; en producción usar secretos del hosting.
# PLATFORM_OWNER_EMAIL=admin@ejemplo.com
# PLATFORM_OWNER_PASSWORD=cambiar-en-primer-arranque

# Nubefact (emisión electrónica). URL completa del panel + token de integración.
# No commitear valores reales; copie a .env local.
NUBEFACT_API_URL=
NUBEFACT_TOKEN=
# Opcional: solo si usa entorno de prueba vía API (entorno_prueba=true)
NUBEFACT_PRUEBA_API_URL=

# Series del formulario de comprobantes (solo lo que defina aquí; sin valores por defecto en código).
# Deben coincidir con Nubefact/SUNAT. Máx. 10 caracteres por variable.
# NUBEFACT_SERIE_FACTURA=
# NUBEFACT_SERIE_BOLETA=
# NUBEFACT_SERIE_NOTA_CREDITO_FACTURA=
# NUBEFACT_SERIE_NOTA_DEBITO_FACTURA=
# NUBEFACT_SERIE_NOTA_CREDITO_BOLETA=
# NUBEFACT_SERIE_NOTA_DEBITO_BOLETA=

# Serie interna cotizaciones (COT1-0001…; no Nubefact). Opcional; por defecto COT1.
# COTIZACION_SERIE_INTERNA=COT1

# Consulta RUC (Bearer). Registro "Consultar SUNAT" no funciona sin token.
# — Decolecta (https://decolecta.com): el token suele empezar por sk_; el backend usa api.decolecta.com/v1.
# — apis.net.pe: token del panel https://apis.net.pe/ → api.apis.net.pe/v2.
# APIS_NET_PE_TOKEN=su_token
# Opcional (solo si quiere forzar URL):
# SUNAT_RUC_API_BASE=https://api.decolecta.com
# SUNAT_RUC_API_PATH=/v1/sunat/ruc
# SUNAT_RUC_API_REFERER=https://decolecta.com
# Referer Decolecta (como el gist con requests). Por defecto: python-decolecta
# SUNAT_RUC_DECOLECTA_REFERER=python-decolecta
# Opcional: SUNAT_RUC_TOKEN_IN_QUERY=true
